{
  "name": "@molotov95/n8n-nodes-max-bot",
  "version": "0.1.1",
  "description": "n8n node for MAX Bot API — send messages, manage chats, receive webhooks",
  "keywords": [
    "n8n-community-node-package",
    "max",
    "bot",
    "messenger",
    "n8n"
  ],
  "license": "MIT",
  "homepage": "https://github.com/molotov95/n8n-nodes-max-bot",
  "author": {
    "name": "MAX Messenger",
    "email": ""
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/molotov95/n8n-nodes-max-bot.git",
    "directory": "n8n-nodes-max-bot"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/MaxBotApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/MaxBot/MaxBot.node.js",
      "dist/nodes/MaxBotTrigger/MaxBotTrigger.node.js",
      "dist/nodes/MaxBotTriggerPolling/MaxBotTriggerPolling.node.js"
    ]
  },
  "scripts": {
    "build": "tsc && gulp build",
    "dev": "tsc --watch",
    "lint": "eslint src/ --ext .ts",
    "test": "jest",
    "prepare": "npm run build",
    "release": "npx @n8n/node-cli release"
  },
  "devDependencies": {
    "@types/node": "^22.5.5",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.2.0",
    "gulp": "^4.0.2",
    "jest": "^29.7.0",
    "n8n-workflow": "^1.48.0",
    "typescript": "^5.4.2"
  },
  "peerDependencies": {
    "n8n-workflow": "^1.48.0"
  }
}
